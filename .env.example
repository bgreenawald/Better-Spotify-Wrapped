# Copy to .env and fill in real values. Never commit .env.

# Spotify API client ID (required for API enrichment calls)
SPOTIFY_CLIENT_ID=your_spotify_client_id
# Spotify API client secret (required for API enrichment calls)
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional: base directory for user data; only used by the legacy export helpers
DATA_DIR=data/example.user
# Path to the DuckDB database (default: data/db/music.db)
MUSIC_DB=data/db/music.db
# Override for the Spotify API cache directory (default: data/api/cache)
SPOTIFY_API_CACHE_DIR=data/api/cache
# Delay in seconds between Spotify API requests (default 1.0)
SPOTIFY_API_RATE_DELAY=1.0

# Set to local/dev/development/test to let .env override existing env vars
ENVIRONMENT=local

# llm/ genre taxonomy scripts: provider to use ("openai" or "gemini"; default openai)
LLM_PROVIDER=openai
# Gemini model name (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# OpenAI model name (default gpt-5-mini)
OPENAI_MODEL=gpt-5-mini
# Google API key (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key
# OpenAI API key (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
